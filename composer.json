{
    "name": "javaabu/nativepdf",
    "type": "library",
    "description": "NativePdf is a CSS 2.1 compliant HTML to PDF converter, a fork of dompdf",
    "homepage": "https://github.com/Javaabu/nativepdf",
    "license": "LGPL-2.1",
    "authors": [
        {
            "name": "Javaabu",
            "homepage": "https://github.com/Javaabu/nativepdf/blob/master/AUTHORS.md"
        }
    ],
    "autoload": {
        "psr-4": {
            "NativePdf\\": "src/"
        },
        "classmap": [
            "lib/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "NativePdf\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^7.1 || ^8.0",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "masterminds/html5": "^2.0",
        "dompdf/php-font-lib": "^1.0.0",
        "dompdf/php-svg-lib": "^1.0.0"
    },
    "require-dev": {
        "ext-gd": "*",
        "ext-json": "*",
        "ext-zip": "*",
        "phpunit/phpunit": "^7.5 || ^8 || ^9 || ^10 || ^11",
        "squizlabs/php_codesniffer": "^3.5",
        "mockery/mockery": "^1.3",
        "symfony/process": "^4.4 || ^5.4 || ^6.2 || ^7.0"
    },
    "suggest": {
        "ext-gd": "Needed to process images",
        "ext-imagick": "Improves image processing performance",
        "ext-gmagick": "Improves image processing performance",
        "ext-zlib": "Needed for pdf stream compression"
    }
}
